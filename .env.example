# ---- Database ----
# Neon (recommended): https://neon.tech — create a project, copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:4000"
# Generate with: openssl rand -base64 32   (or: npx auth secret)
NEXTAUTH_SECRET=""

# ---- Google OAuth (for user sign-in + Google Sheets API) ----
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Meta / Instagram Graph API ----
# Create app at https://developers.facebook.com/apps
# Add Instagram Graph API + Facebook Login products.
# Redirect URI: http://localhost:3000/api/instagram/callback
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"

# ---- Google Gemini (caption generation) ----
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ---- Cloudinary (video storage) ----
# Sign up at https://cloudinary.com — copy from dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: an unsigned upload preset for browser uploads
CLOUDINARY_UPLOAD_PRESET=""

# ---- Resend (transactional email) ----
# Sign up at https://resend.com — generate an API key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Reels Bot <noreply@yourdomain.com>"

# ---- Cron + token signing ----
# Random secret used to authenticate Vercel Cron requests
CRON_SECRET=""
# HMAC secret for signing email approval links
APPROVAL_TOKEN_SECRET=""
# 32-byte (base64) AES key for encrypting Meta tokens at rest
ENCRYPTION_KEY=""
