// Anvaya — multi-platform social media automation SaaS

generator client {
  provider      = "prisma-client-js"
  // native = local dev (Windows). debian-openssl-3.0.x = the DO App Platform
  // container (node:22-bookworm-slim ships OpenSSL 3). Without the second
  // target the prod runtime can't find the query engine binary and every
  // db call throws PrismaClientInitializationError.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- NextAuth ----------

enum UserRole {
  CREATOR
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole?  // null until onboarded
  onboarded     Boolean    @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  socialAccounts    SocialAccount[]
  sheetConnections  SheetConnection[]
  preferences       Preferences?
  posts             Post[]

  // Editor relationships
  editorAssignmentsAsCreator EditorAssignment[] @relation("CreatorAssignments")
  editorAssignmentsAsEditor  EditorAssignment[] @relation("EditorAssignments")
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AssignmentInitiator {
  CREATOR
  EDITOR
}

model EditorAssignment {
  id          String              @id @default(cuid())
  creatorId   String
  editorId    String
  status      AssignmentStatus    @default(PENDING)
  initiatedBy AssignmentInitiator
  message     String?             @db.Text
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  creator User @relation("CreatorAssignments", fields: [creatorId], references: [id], onDelete: Cascade)
  editor  User @relation("EditorAssignments",  fields: [editorId],  references: [id], onDelete: Cascade)

  @@unique([creatorId, editorId])
  @@index([editorId, status])
  @@index([creatorId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App models ----------

enum Platform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  PINTEREST
}

// A connected social account on any platform.
model SocialAccount {
  id              String    @id @default(cuid())
  userId          String
  platform        Platform
  // Platform-specific account identifier (IG business ID, FB page ID, LinkedIn URN, Pinterest ID)
  accountId       String
  username        String?
  displayName     String?
  avatarUrl       String?   @db.Text
  // Encrypted access token
  accessToken     String    @db.Text
  // For Meta: the FB Page access token (IG needs page token, not user token)
  pageId          String?
  tokenExpiresAt  DateTime?
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts       Post[]
  postTargets PostTarget[]

  @@unique([userId, platform, accountId])
  @@index([userId, platform])
}

// Optional Google Sheet ingestion source.
model SheetConnection {
  id            String    @id @default(cuid())
  userId        String
  sheetId       String
  sheetName     String?
  outlineColumn String    @default("Outline")
  fileColumn    String    @default("File Name")
  statusColumn  String    @default("Status")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sheetId])
}

enum ApprovalMode {
  AUTO       // publish without approval
  EMAIL      // email approval before publish
  MANUAL     // user must approve in dashboard
}

model Preferences {
  id            String        @id @default(cuid())
  userId        String        @unique
  captionTone   String        @default("engaging, natural, SEO friendly")
  hashtagCount  Int           @default(2)
  approvalMode  ApprovalMode  @default(EMAIL)
  defaultSlots  Json          @default("[]") // [{hour:9,minute:0},{hour:18,minute:10}]
  systemPrompt  String?       @db.Text       // override caption prompt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PostSource {
  UPLOAD
  SHEET
}

enum MediaType {
  VIDEO      // single video / reel
  PHOTO      // single image
  CAROUSEL   // multi-image (or mixed)
}

enum PostStatus {
  DRAFT              // just created, no caption yet
  CAPTION_PENDING    // caption being generated
  PENDING_APPROVAL   // awaiting user approval
  SCHEDULED          // approved & scheduled
  PUBLISHING         // currently being published
  POSTED             // live on the platform
  REJECTED           // user rejected
  FAILED             // hit terminal failure
}

model Post {
  id              String      @id @default(cuid())
  userId          String
  // Null until the creator picks a social account at scheduling time
  socialAccountId String?
  platform        Platform?

  source          PostSource
  mediaType       MediaType   @default(VIDEO)
  // Primary URL (video URL for VIDEO posts; first image for PHOTO posts)
  mediaUrl        String?     @db.Text
  // All media URLs in order (populated for CAROUSEL and PHOTO; also set for VIDEO)
  mediaUrls       String[]    @default([])
  thumbnailUrl    String?     @db.Text
  outline         String      @db.Text
  caption         String?     @db.Text

  status          PostStatus  @default(DRAFT)
  scheduledAt     DateTime?
  postedAt        DateTime?

  // Platform publishing artifacts
  platformPostId  String?     // generic: IG media ID, LinkedIn post URN, etc.
  platformUrl     String?     @db.Text  // public permalink after posting

  // Legacy IG-specific (kept for backward compat with existing rows)
  igContainerId   String?
  igMediaId       String?
  igPermalink     String?     @db.Text

  // Sheet sync metadata
  sheetRowId      String?
  sheetRowIndex   Int?

  // Failure tracking
  retryCount      Int         @default(0)
  errorMessage    String?     @db.Text

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  approvalTokens  ApprovalToken[]
  targets         PostTarget[]

  @@index([userId, status])
  @@index([status, scheduledAt])
}

// One publish target per social account for a post (multi-account publishing)
enum TargetStatus {
  PENDING      // waiting to be published
  PUBLISHING   // currently in-flight
  POSTED       // live on the platform
  FAILED       // hit an error
}

model PostTarget {
  id              String       @id @default(cuid())
  postId          String
  socialAccountId String
  status          TargetStatus @default(PENDING)
  platformPostId  String?
  platformUrl     String?      @db.Text
  errorMessage    String?      @db.Text
  postedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@index([postId])
}

enum RenderStatus {
  QUEUED
  RENDERING
  UPLOADING
  DONE
  FAILED
}

// One render of a code-defined video template. Template definitions live in
// /remotion/templates/* (see lib/templates.ts registry) — `templateId` is the
// slug from that registry, not a foreign key.
model RenderJob {
  id           String       @id @default(cuid())
  userId       String
  templateId   String
  inputs       Json         // { clip1Url, clip2Url, clip3Url, headline, ... } — matches template props
  status       RenderStatus @default(QUEUED)
  outputUrl    String?      @db.Text
  thumbnailUrl String?      @db.Text
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

enum ApprovalAction {
  APPROVE
  REJECT
  EDIT
}

model ApprovalToken {
  id        String         @id @default(cuid())
  postId    String
  action    ApprovalAction
  token     String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([token])
}
