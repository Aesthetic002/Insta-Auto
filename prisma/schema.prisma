// Instagram automation SaaS schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- NextAuth ----------

enum UserRole {
  CREATOR
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole?  // null until onboarded
  onboarded     Boolean    @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  igAccounts        IgAccount[]
  sheetConnections  SheetConnection[]
  preferences       Preferences?
  posts             Post[]

  // Editor relationships
  editorAssignmentsAsCreator EditorAssignment[] @relation("CreatorAssignments")
  editorAssignmentsAsEditor  EditorAssignment[] @relation("EditorAssignments")
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AssignmentInitiator {
  CREATOR
  EDITOR
}

// Many-to-many between creators and editors. An editor can serve multiple
// creators; a creator can have multiple editors. Once ACCEPTED, the editor
// can read/write posts in the creator's workspace.
model EditorAssignment {
  id          String              @id @default(cuid())
  creatorId   String
  editorId    String
  status      AssignmentStatus    @default(PENDING)
  initiatedBy AssignmentInitiator
  message     String?             @db.Text
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  creator User @relation("CreatorAssignments", fields: [creatorId], references: [id], onDelete: Cascade)
  editor  User @relation("EditorAssignments",  fields: [editorId],  references: [id], onDelete: Cascade)

  @@unique([creatorId, editorId])
  @@index([editorId, status])
  @@index([creatorId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App models ----------

// Connected Instagram Business account (via Meta OAuth).
model IgAccount {
  id                  String   @id @default(cuid())
  userId              String
  igBusinessId        String   // Instagram Business Account ID
  username            String?
  pageId              String   // FB Page that owns the IG account
  pageAccessToken     String   @db.Text // encrypted at rest (AES)
  tokenExpiresAt      DateTime?
  connectedAt         DateTime @default(now())
  disconnectedAt      DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@unique([userId, igBusinessId])
}

// Optional Google Sheet ingestion source.
model SheetConnection {
  id            String    @id @default(cuid())
  userId        String
  sheetId       String
  sheetName     String?
  outlineColumn String    @default("Outline")
  fileColumn    String    @default("File Name")
  statusColumn  String    @default("Status")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sheetId])
}

enum ApprovalMode {
  AUTO       // publish without approval
  EMAIL      // email approval before publish
  MANUAL     // user must approve in dashboard
}

model Preferences {
  id            String        @id @default(cuid())
  userId        String        @unique
  captionTone   String        @default("engaging, natural, SEO friendly")
  hashtagCount  Int           @default(2)
  approvalMode  ApprovalMode  @default(EMAIL)
  defaultSlots  Json          @default("[]") // [{hour:9,minute:0},{hour:18,minute:10}]
  systemPrompt  String?       @db.Text       // override caption prompt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PostSource {
  UPLOAD
  SHEET
}

enum PostStatus {
  DRAFT              // just created, no caption yet
  CAPTION_PENDING    // caption being generated
  PENDING_APPROVAL   // awaiting user approval
  SCHEDULED          // approved & scheduled
  PUBLISHING         // currently being published
  POSTED             // live on Instagram
  REJECTED           // user rejected
  FAILED             // hit terminal failure
}

model Post {
  id            String      @id @default(cuid())
  userId        String
  igAccountId   String

  source        PostSource
  videoUrl      String      @db.Text
  thumbnailUrl  String?     @db.Text
  outline       String      @db.Text
  caption       String?     @db.Text

  status        PostStatus  @default(DRAFT)
  scheduledAt   DateTime?
  postedAt      DateTime?

  // Instagram publishing artifacts
  igContainerId String?
  igMediaId     String?
  igPermalink   String?     @db.Text

  // Sheet sync metadata
  sheetRowId    String?
  sheetRowIndex Int?

  // Failure tracking
  retryCount    Int         @default(0)
  errorMessage  String?     @db.Text

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  igAccount      IgAccount        @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  approvalTokens ApprovalToken[]

  @@index([userId, status])
  @@index([status, scheduledAt])
}

enum ApprovalAction {
  APPROVE
  REJECT
  EDIT
}

model ApprovalToken {
  id        String         @id @default(cuid())
  postId    String
  action    ApprovalAction
  token     String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([token])
}
